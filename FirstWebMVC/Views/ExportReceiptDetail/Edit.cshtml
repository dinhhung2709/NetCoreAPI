@model FirstWebMVC.Models.ExportReceiptDetail

@{
    ViewData["Title"] = "Edit";
}

<h1>Sửa chi tiết phiếu xuất</h1>

<h4>ExportReceiptDetail</h4>
<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <!-- PHIẾU XUẤT -->
            <div class="form-group mb-3">
                <label asp-for="ExportReceiptId" class="control-label">
                    Phiếu xuất
                </label>

                <select asp-for="ExportReceiptId"
                        class="form-control"
                        asp-items="ViewBag.ExportReceiptId">
                </select>

                <span asp-validation-for="ExportReceiptId"
                      class="text-danger">
                </span>
            </div>

            <!-- THIẾT BỊ -->
            <div class="form-group mb-3">
                <label asp-for="DeviceId" class="control-label">
                    Thiết bị
                </label>

                <select asp-for="DeviceId"
                        class="form-control"
                        asp-items="ViewBag.DeviceId">
                </select>

                <span asp-validation-for="DeviceId"
                      class="text-danger">
                </span>
            </div>

            <!-- SỐ LƯỢNG -->
            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label">
                    Số lượng
                </label>

                <input asp-for="Quantity"
                       class="form-control"
                       placeholder="Nhập số lượng" />

                <span asp-validation-for="Quantity"
                      class="text-danger">
                </span>
            </div>

            <!-- ĐƠN GIÁ -->
            <div class="form-group mb-3">
                <label asp-for="UnitPrice" class="control-label">
                    Đơn giá xuất
                </label>

                <input asp-for="UnitPrice"
                       class="form-control"
                       placeholder="Nhập đơn giá xuất" />

                <span asp-validation-for="UnitPrice"
                      class="text-danger">
                </span>
            </div>

            <!-- NÚT SAVE -->
            <div class="form-group mt-3">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}