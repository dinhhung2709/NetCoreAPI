@model FirstWebMVC.Models.Student

<h2>Sửa sinh viên</h2>

<form asp-action="Edit" method="post">

    <!-- QUAN TRỌNG -->
    <input type="hidden" asp-for="Id" />

    <div>
        <label>Mã SV</label>
        <input asp-for="StudentCode" />
    </div>

    <div>
        <label>Tên</label>
        <input asp-for="FullName" />
    </div>

    <div>
        <label>Tuổi</label>
        <input asp-for="Age" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <button type="submit">Cập nhật</button>
</form>

<a href="/Student">Quay lại</a>