@model IEnumerable<FirstWebMVC.ViewModels.StudentVM>

<h2>Danh sách sinh viên</h2>

<a href="/Student/Create">➕ Thêm sinh viên</a>

<table border="1">
    <thead>
        <tr>
            <th>Mã sinh viên</th>
            <th>Họ tên</th>
            <th>Khoa</th>
            <th>Hành động</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentCode</td>
                <td>@item.FullName</td>
                <td>@item.FacultyName</td>

                <td>
                    <a href="/Student/Edit/@item.Id">Sửa</a> |
                    <a href="/Student/Delete/@item.Id">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>