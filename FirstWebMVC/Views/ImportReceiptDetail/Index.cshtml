@model IEnumerable<FirstWebMVC.Models.ImportReceiptDetail>

@{
    ViewData["Title"] = "Danh sách chi tiết phiếu nhập";
}

<h1>Danh sách chi tiết phiếu nhập</h1>

<p>
    <a asp-action="Create"
       class="btn btn-primary">

        Thêm chi tiết phiếu nhập

    </a>
</p>

<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>
            <!-- PHIẾU NHẬP -->
            <th>
                Phiếu nhập
            </th>

            <!-- THIẾT BỊ -->
            <th>
                Thiết bị
            </th>

            <!-- SỐ LƯỢNG -->
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>

            <!-- ĐƠN GIÁ -->
            <th>
                @Html.DisplayNameFor(model => model.UnitPrice)
            </th>

            <!-- THÀNH TIỀN -->
            <th>
                @Html.DisplayNameFor(model => model.TotalPrice)
            </th>

            <!-- CHỨC NĂNG -->
            <th>
                Chức năng
            </th>
        </tr>

    </thead>

    <tbody>

@foreach (var item in Model)
{
        <tr>

            <!-- BƯỚC 9: HIỂN THỊ PHIẾU NHẬP -->
            <td>
                @item.ImportReceiptId
            </td>

            <!-- BƯỚC 9: HIỂN THỊ TÊN THIẾT BỊ -->
            <td>
                @item.Device?.Name
            </td>

            <!-- SỐ LƯỢNG -->
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>

            <!-- ĐƠN GIÁ -->
            <td>
                @Html.DisplayFor(modelItem => item.UnitPrice)
            </td>

            <!-- THÀNH TIỀN -->
            <td>
                @Html.DisplayFor(modelItem => item.TotalPrice)
            </td>

            <!-- NÚT CHỨC NĂNG -->
            <td>

                <a asp-action="Edit"
                   asp-route-id="@item.Id"
                   class="btn btn-warning btn-sm">

                    Sửa

                </a>

                <a asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-info btn-sm">

                    Chi tiết

                </a>

                <a asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-danger btn-sm">

                    Xoá

                </a>

            </td>

        </tr>
}

    </tbody>

</table>

