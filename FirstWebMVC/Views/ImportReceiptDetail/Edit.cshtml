@model FirstWebMVC.Models.ImportReceiptDetail

@{
    ViewData["Title"] = "Edit";
}

<h1>Chỉnh sửa chi tiết phiếu nhập</h1>

<h4>Cập nhật thông tin thiết bị nhập kho</h4>

<hr />

<div class="row">
    <div class="col-md-4">

        <!-- FORM EDIT -->
        <form asp-action="Edit">

            <!-- ID ẨN -->
            <input type="hidden" asp-for="Id" />

            <!-- HIỂN THỊ LỖI -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <!-- PHIẾU NHẬP -->
            <div class="form-group mb-3">

                <label asp-for="ImportReceiptId"
                       class="control-label"></label>

                <!-- DROPDOWN PHIẾU NHẬP -->
                <select asp-for="ImportReceiptId"
                        class="form-control"
                        asp-items="ViewBag.ImportReceiptId">

                    <option value="">
                        -- Chọn phiếu nhập --
                    </option>

                </select>

                <span asp-validation-for="ImportReceiptId"
                      class="text-danger"></span>
            </div>

            <!-- THIẾT BỊ -->
            <div class="form-group mb-3">

                <label asp-for="DeviceId"
                       class="control-label"></label>

                <!-- BƯỚC 6: DROPDOWN THIẾT BỊ -->
                <select asp-for="DeviceId"
                        class="form-control"
                        asp-items="ViewBag.DeviceId">

                    <option value="">
                        -- Chọn thiết bị --
                    </option>

                </select>

                <span asp-validation-for="DeviceId"
                      class="text-danger"></span>
            </div>

            <!-- SỐ LƯỢNG -->
            <div class="form-group mb-3">

                <label asp-for="Quantity"
                       class="control-label"></label>

                <input asp-for="Quantity"
                       class="form-control" />

                <span asp-validation-for="Quantity"
                      class="text-danger"></span>
            </div>

            <!-- ĐƠN GIÁ -->
            <div class="form-group mb-3">

                <label asp-for="UnitPrice"
                       class="control-label"></label>

                <input asp-for="UnitPrice"
                       class="form-control" />

                <span asp-validation-for="UnitPrice"
                      class="text-danger"></span>
            </div>

            <!--
                BƯỚC 7:
                KHÔNG CHO NHẬP TotalPrice

                Vì Controller đã tự tính:
                TotalPrice = Quantity * UnitPrice
            -->

            <!-- NÚT LƯU -->
            <div class="form-group">

                <input type="submit"
                       value="Lưu thay đổi"
                       class="btn btn-primary" />

            </div>

        </form>
    </div>
</div>

<!-- QUAY LẠI -->
<div class="mt-3">

    <a asp-action="Index"
       class="btn btn-secondary">

        Quay lại danh sách

    </a>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
